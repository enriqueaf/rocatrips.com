---
// Sitewide "climb with Rocatrips" call to action. Shown at the end of every
// page (except booking/legal), so every resource page ends with the CTA.
import { Image } from 'astro:assets';
import { ui, type Locale } from '../i18n';
import { byKey } from '../lib/routes';
import { photo } from '../lib/images';
import Icon from './Icon.astro';

interface Props { lang: Locale; bookUrl: string; }
const { lang, bookUrl } = Astro.props;
const t = ui[lang];
const experiences = await byKey('experiences', lang);
const contact = await byKey('contact', lang);
const pic = photo('anaga-ridges');
---

<aside class="cta" aria-label={t.ctaTitle}>
  <Image src={pic.src} alt="" widths={[640, 1024, 1600, 2200]} sizes="100vw" class="cta__img" />
  <div class="cta__inner">
    <h2 class="display">{t.ctaTitle}</h2>
    <p>{t.ctaText}</p>
    <div class="cta__actions">
      <a class="btn" href={bookUrl} rel="noopener" target="_blank">{t.book}</a>
      {experiences && <a class="btn btn--light" href={experiences.data.path}>{t.ctaButton}</a>}
      {contact && <a class="cta__link" href={contact.data.path}>{t.ctaContact} <Icon name="arrow-right" size="18px" /></a>}
    </div>
  </div>
</aside>

<style>
  .cta { position: relative; isolation: isolate; color: #fff; background: var(--ink); text-align: center; }
  .cta__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cta::after { content: ''; position: absolute; inset: 0; background: rgb(10 12 16 / 0.62); z-index: -1; }
  .cta__inner { max-width: 760px; margin: 0 auto; padding: clamp(64px, 9vw, 120px) var(--gutter); }
  .cta h2 { font-size: clamp(28px, 4vw, 48px); margin: 0 0 16px; color: #fff; }
  .cta p { font-size: 18px; margin: 0 auto 30px; max-width: 52ch; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px 14px; justify-content: center; align-items: center; }
  .cta__link { display: inline-flex; align-items: center; gap: 6px; color: #fff; font: 800 13px/1 var(--font); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; padding: 8px 4px; }
  .cta__link:hover { text-decoration: underline; }
</style>
