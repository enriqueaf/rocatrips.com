---
// Split section: photo on one side, numbered reasons on the other.
import { Image } from 'astro:assets';
import type { Photo } from '../lib/images';

interface Props {
  heading: string;
  photo: Photo;
  items: { title: string; text: string; href?: string }[];
  link?: { label: string; href: string };
  /** Guide's association badge, overlaid on the photo. */
  badge?: { title: string; text: string; href: string; logo: string };
}
const { heading, photo, items, link, badge } = Astro.props;
---

<section class="reasons bleed">
  <div class="reasons__media">
    <Image src={photo.src} alt={photo.alt} widths={[640, 1024, 1400]} sizes="(max-width: 900px) 100vw, 50vw" />
    {badge && (
      <a class="badge" href={badge.href} target="_blank" rel="noopener">
        <img src={badge.logo} alt="AEGM" width="56" height="64" loading="lazy" />
        <span><strong>{badge.title}</strong>{badge.text}</span>
      </a>
    )}
  </div>
  <div class="reasons__body">
    <h2>{heading}</h2>
    <ol>
      {items.map((item, i) => (
        <li>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
    {link && <a class="btn btn--ghost" href={link.href}>{link.label}</a>}
  </div>
</section>

<style>
  .reasons { display: grid; grid-template-columns: 1fr 1fr; background: var(--surface); margin-block: clamp(56px, 8vw, 104px); }
  .reasons__media { position: relative; min-height: 420px; }
  .reasons__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .badge { position: absolute; left: 20px; bottom: 20px; z-index: 1; display: flex; align-items: center; gap: 12px; max-width: calc(100% - 40px); padding: 10px 16px 10px 10px; background: rgb(255 255 255 / 0.94); color: var(--ink); text-decoration: none; box-shadow: 0 4px 20px rgb(0 0 0 / 0.18); }
  .reasons__media .badge img { position: static; inset: auto; width: 56px; height: auto; flex: none; object-fit: contain; }
  .badge span { display: grid; gap: 2px; font-size: 13px; line-height: 1.35; color: #3a3d42; }
  .badge strong { font-size: 15px; color: #1d1d1b; }
  .reasons__body { padding: clamp(40px, 6vw, 88px) var(--gutter) clamp(40px, 6vw, 88px) clamp(32px, 5vw, 72px); max-width: 680px; }
  .reasons h2 { margin: 0 0 28px; }
  ol { list-style: none; padding: 0; margin: 0 0 32px; }
  li { display: grid; grid-template-columns: 52px 1fr; gap: 12px; padding: 16px 0; border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  .num { font: 900 22px/1.1 var(--font); font-stretch: 125%; color: var(--accent); }
  h3 { margin: 0 0 4px; font-size: 16px; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .btn--ghost { color: var(--ink); }
  .btn--ghost:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  @media (max-width: 900px) {
    .reasons { grid-template-columns: 1fr; }
    .reasons__media { min-height: 300px; }
    .reasons__body { padding: 40px var(--gutter); }
  }
</style>
