---
import { Image } from 'astro:assets';
import type { AnyEntry } from '../lib/routes';
import { photoFor } from '../lib/images';
import { levelLabels, ui, type Locale } from '../i18n';

const { entry } = Astro.props as { entry: AnyEntry };
const d = entry.data;
const lang = d.lang as Locale;
const text = 'summary' in d ? d.summary : d.description;
const pic = photoFor(entry);
---

<li class="card">
  <div class="card__media">
    <Image src={pic.src} alt="" widths={[400, 640, 900]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px" />
    {entry.collection === 'experiences' && entry.data.priceFrom != null && (
      <span class="card__price">{ui[lang].from} €{entry.data.priceFrom}</span>
    )}
  </div>
  <div class="card__body">
    {entry.collection === 'experiences' && (
      <p class="eyebrow">{levelLabels[lang][entry.data.level]} · {entry.data.duration}</p>
    )}
    {entry.collection === 'areas' && <p class="eyebrow">{entry.data.region}{entry.data.grades && <> · {entry.data.grades}</>}</p>}
    <h3><a href={d.path}>{d.navLabel ?? d.h1 ?? d.title}</a></h3>
    <p>{text}</p>
    <span class="card__more" aria-hidden="true">{ui[lang].readMore} →</span>
  </div>
</li>

<style>
  .card { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.45); }
  .card__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--ink); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .card__media img { transform: scale(1.04); }
  .card__price { position: absolute; left: 0; bottom: 0; background: var(--accent); color: #fff; font: 800 13px/1 var(--font); letter-spacing: 0.06em; text-transform: uppercase; padding: 9px 12px; }
  .card__body { display: flex; flex-direction: column; flex: 1; padding: 20px 20px 22px; }
  .card h3 { font-size: 19px; margin: 0 0 10px; }
  .card h3 a { color: inherit; text-decoration: none; }
  /* Whole card is clickable, one link in the a11y tree. */
  .card h3 a::after { content: ''; position: absolute; inset: 0; }
  .card h3 a:focus-visible { outline: none; }
  .card:has(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .card p:not(.eyebrow) { margin: 0 0 16px; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .card .eyebrow { margin: 0 0 8px; }
  .card__more { margin-top: auto; font: 800 12px/1 var(--font); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
</style>
