---
// Full-bleed feature banner: photo with a heading, text and one button.
import { Image } from 'astro:assets';
import type { Photo } from '../lib/images';

interface Props { photo: Photo; title: string; text: string; href: string; label: string; }
const { photo, title, text, href, label } = Astro.props;
---

<section class="banner bleed">
  <Image src={photo.src} alt={photo.alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" class="banner__img" />
  <div class="banner__inner">
    <h2 class="display">{title}</h2>
    <p>{text}</p>
    <a class="btn" href={href}>{label}</a>
  </div>
</section>

<style>
  .banner { position: relative; display: grid; min-height: clamp(380px, 48vw, 600px); color: #fff; background: var(--ink); isolation: isolate; margin-block: clamp(48px, 7vw, 96px); }
  .banner__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .banner::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, rgb(18 30 48 / 0.85), rgb(18 30 48 / 0.4) 45%, transparent 75%); }
  .banner__inner { align-self: center; width: 100%; max-width: var(--wide); margin: 0 auto; padding: 48px var(--gutter); }
  .banner h2 { font-size: clamp(28px, 3.6vw, 44px); margin: 0 0 18px; max-width: 14ch; color: #fff; }
  .banner p { max-width: 44ch; font-size: 18px; line-height: 1.55; margin: 0 0 28px; }
  @media (max-width: 640px) { .banner::after { background: rgb(18 30 48 / 0.6); } }
</style>
