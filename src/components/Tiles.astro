---
// Photo mosaic: one big tile and three smaller ones, title over the photo.
import { Image } from 'astro:assets';
import { photo } from '../lib/images';

interface Props {
  heading: string;
  items: { title: string; text: string; image?: string; href?: string }[];
}
const { heading, items } = Astro.props;
---

<section class="tiles-section">
  <h2>{heading}</h2>
  <ul class="tiles">
    {items.map((item, i) => {
      const pic = photo(item.image ?? 'teide-roques-morning');
      return (
        <li class="tile">
          <Image src={pic.src} alt={pic.alt} widths={[480, 800, 1200]} sizes={i === 0 ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 100vw, 25vw'} />
          <div class="tile__text">
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .tiles-section { margin: clamp(56px, 8vw, 104px) 0; }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(220px, 22vw, 300px); gap: 12px; padding: 0; margin: 0; list-style: none; }
  .tile { position: relative; overflow: hidden; background: var(--ink); color: #fff; isolation: isolate; }
  .tile:first-child { grid-column: span 2; grid-row: span 2; }
  .tile:nth-child(2) { grid-column: span 2; }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 0.6s ease; }
  .tile:hover img { transform: scale(1.04); }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(10 12 16 / 0.8), rgb(10 12 16 / 0.1) 60%); }
  .tile__text { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(18px, 2.4vw, 32px); }
  .tile h3 { color: #fff; margin: 0 0 6px; font-size: clamp(18px, 1.8vw, 24px); }
  .tile:first-child h3 { font-size: clamp(24px, 3vw, 40px); }
  .tile h3 a { color: inherit; text-decoration: none; }
  .tile p { margin: 0; max-width: 40ch; font-size: 15px; line-height: 1.45; opacity: 0.92; }
  @media (max-width: 760px) {
    .tiles { grid-template-columns: 1fr; grid-auto-rows: 240px; }
    .tile:first-child, .tile:nth-child(2) { grid-column: auto; grid-row: auto; }
    .tile:first-child { grid-row: span 1; height: 320px; }
  }
</style>
