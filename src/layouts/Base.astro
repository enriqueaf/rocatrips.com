---
import { site } from '../site.config';
import { defaultLocale, localeNames, mainNav, footerNav, ui, type Locale } from '../i18n';
import { byKey, translations, breadcrumbs, type AnyEntry } from '../lib/routes';
import { organization, breadcrumbList } from '../lib/schema';
import { mdPath } from '../lib/markdown';
import Icon from '../components/Icon.astro';

interface Props {
  entry: AnyEntry;
  bookUrl: string;
  schema?: object[];
}
const { entry, bookUrl, schema = [] } = Astro.props;
const d = entry.data;
const lang = d.lang as Locale;
const t = ui[lang];
const canonical = new URL(d.path, site.url).toString();

const alternates = await translations(entry);
const xDefault = alternates.find((a) => a.data.lang === defaultLocale);
const trail = await breadcrumbs(entry);

const resolveNav = async (keys: readonly string[]) =>
  (await Promise.all(keys.map((k) => byKey(k, lang)))).filter((e): e is AnyEntry => !!e);
const nav = await resolveNav(mainNav);
const footer = await resolveNav(footerNav);
const homePath = lang === defaultLocale ? '/' : `/${lang}/`;

const jsonLd = [organization(), ...(trail.length > 1 ? [breadcrumbList(trail)] : []), ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.title}</title>
    <meta name="description" content={d.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.data.lang} href={new URL(a.data.path, site.url).toString()} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.data.path, site.url).toString()} />}
    {d.draft ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}
    {/* AI-readable versions of this page and of the whole site */}
    <link rel="alternate" type="text/markdown" href={mdPath(d.path)} title="Markdown version" />
    <link rel="help" type="text/plain" href="/llms.txt" title="llms.txt" />

    <meta property="og:type" content={entry.collection === 'guides' ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={d.h1 ?? d.title} />
    <meta property="og:description" content={d.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang} />
    {/* TODO: og:image per page once photos arrive (1200x630) */}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&display=swap" />

    <style is:global>
      :root {
        --ink: #0c0d0f; --fg: #16171a; --muted: #5d6066; --bg: #f5f4f1; --surface: #fff; --line: #dedbd4;
        --accent: #d4521c; --accent-dark: #b2420f;
        --font: 'Archivo', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --wide: 1240px; --narrow: 760px; --gutter: clamp(16px, 4vw, 40px);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { overflow-x: clip; -webkit-text-size-adjust: 100%; }
      body { margin: 0; font: 400 17px/1.65 var(--font); color: var(--fg); background: var(--bg); -webkit-font-smoothing: antialiased; }
      img { display: block; max-width: 100%; height: auto; }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:hover { color: var(--accent-dark); }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      [id] { scroll-margin-top: 88px; } /* clear the sticky header on #anchor jumps */

      /* Type: wide, heavy, uppercase display headings */
      h1, h2, h3, .display { font-family: var(--font); font-weight: 900; font-stretch: 125%; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.04; color: var(--ink); text-wrap: balance; }
      h2 { font-size: clamp(24px, 2.6vw, 32px); margin: 56px 0 18px; }
      h3 { font-size: 18px; margin: 32px 0 10px; line-height: 1.2; }
      .eyebrow { font: 800 12px/1.3 var(--font); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--accent); color: #fff; border: 2px solid var(--accent); padding: 13px 22px; font: 900 13px/1 var(--font); font-stretch: 125%; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: background 0.15s, border-color 0.15s, color 0.15s; }
      .btn:hover { background: var(--accent-dark); border-color: var(--accent-dark); color: #fff; }
      .btn--light { background: #fff; border-color: #fff; color: var(--ink); }
      .btn--light:hover { background: transparent; color: #fff; border-color: #fff; }
      .btn--ghost { background: transparent; border-color: currentColor; color: inherit; }

      .bleed { width: 100vw; margin-inline: calc(50% - 50vw); }
      .wrap { max-width: var(--wide); margin: 0 auto; padding-inline: var(--gutter); }

      /* Header: thin utility bar + black main bar */
      .util { background: #fff; color: var(--ink); font-size: 13px; border-bottom: 1px solid var(--line); }
      .util .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 34px; }
      .util .tag { font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; }
      .util nav { display: flex; gap: 14px; }
      .util a { color: var(--muted); text-decoration: none; }
      .util a:hover { color: var(--ink); }
      .util strong { font-weight: 700; }
      .site-header { position: sticky; top: 0; z-index: 50; background: var(--ink); color: #fff; }
      .site-header .wrap { display: flex; align-items: center; gap: 28px; min-height: 64px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font: 900 20px/1 var(--font); font-stretch: 112%; letter-spacing: -0.01em; }
      .brand:hover { color: #fff; }
      .brand svg { width: 22px; height: 22px; color: var(--accent); }
      .menu { display: flex; align-items: center; gap: 26px; margin-left: auto; }
      .menu ul { display: flex; gap: 22px; margin: 0; padding: 0; list-style: none; }
      .menu ul a { color: #fff; text-decoration: none; font: 900 12px/1 var(--font); font-stretch: 125%; letter-spacing: 0.08em; text-transform: uppercase; padding: 8px 0; border-bottom: 2px solid transparent; }
      .menu ul a:hover, .menu ul a[aria-current] { border-color: var(--accent); }
      .menu .btn { padding: 11px 18px; }
      .menu-toggle { display: none; }
      @media (max-width: 960px) {
        .menu-toggle { display: block; margin-left: auto; }
        .menu-toggle summary { display: flex; align-items: center; gap: 8px; list-style: none; cursor: pointer; font: 900 12px/1 var(--font); font-stretch: 125%; letter-spacing: 0.1em; text-transform: uppercase; padding: 12px 0 12px 12px; }
        .menu-toggle summary::-webkit-details-marker { display: none; }
        .menu-toggle .icon { color: var(--accent); }
        .menu-toggle .i-close, .menu-toggle[open] .i-open { display: none; }
        .menu-toggle[open] .i-close { display: block; }
        .menu-toggle:not([open]) + .menu { display: none; }
        .menu { position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; padding: 8px var(--gutter) 24px; background: var(--ink); border-top: 1px solid #26282c; }
        .menu ul { flex-direction: column; gap: 0; }
        .menu ul a { display: block; padding: 16px 0; font-size: 15px; border-bottom: 1px solid #26282c; }
        .menu .btn { margin-top: 18px; padding: 15px; }
        .util .tag { display: none; }
      }
      @media (min-width: 961px) { .menu-toggle { display: none !important; } }

      /* Content */
      main { max-width: var(--wide); margin: 0 auto; padding: 28px var(--gutter) 64px; }
      .crumbs { font-size: 13px; color: var(--muted); margin: 0 0 32px; }
      .crumbs a { color: var(--muted); }
      .prose { max-width: var(--narrow); }
      .prose > :first-child { margin-top: 0; }
      .prose ul { padding-left: 1.2em; }
      .prose li { margin: 6px 0; }
      .prose li::marker { color: var(--accent); }
      .prose strong { color: var(--ink); }
      /* Tables: the <table> itself is the scroll box (display: block), so wide
         tables scroll sideways on phones; on desktop they may run wider than
         the text column. */
      .prose table { display: block; width: max-content; max-width: calc(min(100vw, var(--wide)) - 2 * var(--gutter)); margin: 28px 0 36px; overflow-x: auto; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--accent); font-size: 15px; line-height: 1.45; -webkit-overflow-scrolling: touch; }
      .prose thead th { background: var(--ink); color: #fff; text-align: left; vertical-align: bottom; padding: 14px 16px; font: 900 11px/1.3 var(--font); font-stretch: 125%; letter-spacing: 0.1em; text-transform: uppercase; }
      .prose td { padding: 13px 16px; border-top: 1px solid var(--line); vertical-align: top; min-width: 150px; }
      .prose tbody tr:nth-child(even) td { background: #faf9f6; }
      .prose tbody tr:hover td { background: #fff4ec; }
      .prose td:first-child { font-weight: 800; color: var(--ink); min-width: 110px; }
      .prose td a { font-weight: 700; }
      @media (max-width: 640px) { .prose table { font-size: 14px; } .prose thead th, .prose td { padding: 11px 12px; } .prose td { min-width: 130px; } .prose td:first-child { min-width: 90px; } }
      .summary { font-size: 20px; line-height: 1.5; color: var(--ink); max-width: var(--narrow); }

      .facts { display: flex; flex-wrap: wrap; gap: 1px; margin: 0 0 28px; background: var(--surface); border: 1px solid var(--line); }
      .facts > div { flex: 1 1 170px; padding: 18px 18px 16px; outline: 1px solid var(--line); }
      .facts .icon { display: block; color: var(--accent); margin-bottom: 10px; }
      .facts dt { font: 800 11px/1.3 var(--font); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
      .facts dd { margin: 0; font-weight: 700; color: var(--ink); line-height: 1.4; }
      .facts .warn { background: #fff4ec; }
      .facts .warn dt { color: var(--accent-dark); }

      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 24px; padding: 0; margin: 24px 0 48px; list-style: none; }

      .faq { max-width: var(--narrow); }
      .faq details { border-bottom: 1px solid var(--line); }
      .faq details:first-of-type { border-top: 1px solid var(--line); }
      .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 18px 0; font-weight: 700; color: var(--ink); }
      .faq summary::-webkit-details-marker { display: none; }
      .faq__toggle { flex: none; color: var(--accent); transition: transform 0.2s ease; }
      .faq details[open] .faq__toggle { transform: rotate(45deg); }
      .faq details p { margin: 0 0 20px; color: var(--muted); }

      .updated { font-size: 13px; color: var(--muted); margin: 48px 0 0; }

      /* Footer */
      .site-footer { background: var(--ink); color: #b9bcc2; font-size: 14px; }
      .site-footer .wrap { padding-block: 56px 32px; }
      .site-footer .brand { margin-bottom: 14px; }
      .site-footer nav { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px 24px; margin: 28px 0 36px; }
      .site-footer a { color: #e6e7ea; text-decoration: none; }
      .site-footer a:hover { color: #fff; text-decoration: underline; }
      .site-footer .legal { border-top: 1px solid #26282c; padding-top: 20px; margin: 0; font-size: 13px; }

      .todo { background: #fff4cc; color: #1d1d1b; padding: 2px 6px; }
      /* Placeholders are visible in `npm run dev` only, never on the live site. */
      body:not(.dev) .todo { display: none; }
      /* Page transitions: native cross-document View Transitions (no JS).
         Header stays put; the page slides up and fades in.
         Unsupported browsers simply navigate as usual. */
      @view-transition { navigation: auto; }
      .site-header { view-transition-name: site-header; }
      .util { view-transition-name: util-bar; }
      ::view-transition-old(root) { animation: vt-out 0.18s ease-in both; }
      ::view-transition-new(root) { animation: vt-in 0.32s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
      @keyframes vt-out { to { opacity: 0; } }
      @keyframes vt-in { from { opacity: 0; transform: translateY(14px); } }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; }
        ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
      }
    </style>
  </head>
  <body class={import.meta.env.DEV ? 'dev' : undefined}>
    <div class="util">
      <div class="wrap">
        <span class="tag">{site.tagline}</span>
        {alternates.length > 1 && (
          <nav aria-label="Language">
            {alternates.map((a) =>
              a.data.lang === lang ? <strong>{localeNames[a.data.lang]}</strong> : <a href={a.data.path} hreflang={a.data.lang}>{localeNames[a.data.lang]}</a>,
            )}
          </nav>
        )}
      </div>
    </div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={homePath}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 22 20H2Z" /><path fill="#0c0d0f" d="m12 9 4 7H8Z" /></svg>
          {site.name}
        </a>
        <details class="menu-toggle"><summary>{t.menu}<Icon name="menu" size="22px" class="i-open" /><Icon name="xmark" size="22px" class="i-close" /></summary></details>
        <nav class="menu" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.data.path} aria-current={d.path === n.data.path ? 'page' : d.path.startsWith(n.data.path) ? 'true' : undefined}>{n.data.navLabel ?? n.data.title}</a></li>)}
          </ul>
          <a class="btn" href={bookUrl} rel="noopener" target="_blank">{t.book}</a>
        </nav>
      </div>
    </header>

    <slot name="hero" />

    <main>
      {trail.length > 1 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {trail.map((c, i) => (i < trail.length - 1 ? <><a href={c.path}>{c.name}</a> / </> : <span>{c.name}</span>))}
        </nav>
      )}
      <slot />
      <p class="updated">{t.updated}: <time datetime={d.updated.toISOString().slice(0, 10)}>{d.updated.toISOString().slice(0, 10)}</time></p>
    </main>

    <slot name="after" />

    <footer class="site-footer">
      <div class="wrap">
        <a class="brand" href={homePath}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 22 20H2Z" /><path fill="#0c0d0f" d="m12 9 4 7H8Z" /></svg>
          {site.name}
        </a>
        <div>{site.tagline}</div>
        <nav aria-label="Footer">{footer.map((n) => <a href={n.data.path}>{n.data.navLabel ?? n.data.title}</a>)}</nav>
        <p class="legal">© {new Date().getFullYear()} {site.name} · {site.address.locality}, Tenerife</p>
      </div>
    </footer>
  </body>
</html>
