---
// One route renders every content entry at its own `path`. Add a page by adding
// a Markdown file; no new .astro file needed.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Cta from '../components/Cta.astro';
import TrustBar from '../components/TrustBar.astro';
import Hero from '../components/Hero.astro';
import Banner from '../components/Banner.astro';
import Stats from '../components/Stats.astro';
import Tiles from '../components/Tiles.astro';
import Reasons from '../components/Reasons.astro';
import { Image } from 'astro:assets';
import { photoFor, photo } from '../lib/images';
import { allEntries, byKey, listing, bookingUrl, type AnyEntry } from '../lib/routes';
import { forEntry } from '../lib/schema';
import { site } from '../site.config';
import { ui, levelLabels, type Locale } from '../i18n';

export async function getStaticPaths() {
  const entries = await allEntries();
  return entries.map((entry) => ({
    params: { slug: entry.data.path.replace(/^\/|\/$/g, '') || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: AnyEntry };
const d = entry.data;
const lang = d.lang as Locale;
const t = ui[lang];
const { Content } = await render(entry);
const bookUrl = bookingUrl(entry, site.kinecall.bookingUrl);
const schema = forEntry(entry, bookUrl);

const template = entry.collection === 'pages' ? entry.data.template : entry.collection;
const showCta = entry.collection !== 'pages' || entry.data.cta;
const showTrust = entry.collection === 'experiences' || template === 'experiences-hub' || d.translationKey === 'about';
// On the experiences hub the cards come first, so the "why us" body doesn't push them down.
const cardsFirst = template === 'experiences-hub';

// FAQ grouped by `group`, keeping first-appearance order.
const faqGroups = [...Map.groupBy(d.faq, (f) => f.group ?? '')];
const exp = entry.collection === 'experiences' ? entry.data : null;
const area = entry.collection === 'areas' ? entry.data : null;

// Listings for hub templates
const experiences = ['home', 'experiences-hub'].includes(template) ? await listing('experiences', lang) : [];
const areas = template === 'areas-hub' ? await listing('areas', lang) : [];
const guides = template === 'guides-hub' ? await listing('guides', lang) : [];
const planPages =
  template === 'plan-hub'
    ? (await listing('pages', lang)).filter((p) => p.data.path !== d.path && p.data.path.startsWith(d.path))
    : [];

const resolve = async (keys: string[]) =>
  (await Promise.all(keys.map((k) => byKey(k, lang)))).filter((e): e is AnyEntry => !!e);
const relatedKeys = exp?.related ?? (entry.collection === 'guides' ? entry.data.related : []);
const related = await resolve(relatedKeys);
const linkedAreas = await resolve(exp?.areas ?? []);
const linkedExperiences = await resolve(area?.experiences ?? []);
const isHome = template === 'home';
const page = entry.collection === 'pages' ? entry.data : null;
const section = (id: string) => page?.sections.find((s) => s.id === id);
const tenerife = section('tenerife');
const whyUs = section('why-us');
const contactPage = isHome ? await byKey('contact', lang) : undefined;
const promoPic = photo('taganana-light');
const areasHub = isHome ? await byKey('areas', lang) : undefined;
const lead = 'summary' in d && d.summary ? d.summary : isHome ? d.description : undefined;
const eyebrow = exp ? `${levelLabels[lang][exp.level]} · ${exp.duration}` : area ? area.region : undefined;
---

<Base entry={entry} bookUrl={bookUrl} schema={schema}>
  <Hero slot="hero" photo={photoFor(entry)} title={d.h1 ?? d.title} lead={lead} eyebrow={eyebrow} size={isHome ? 'full' : 'page'}>
    {(isHome || exp) && <a class="btn" href={bookUrl} rel="noopener" target="_blank">{t.book}</a>}
    {isHome && experiences.length > 0 && <a class="btn btn--light" href="#experiences">{t.ctaButton}</a>}
  </Hero>
  {page && page.stats.length > 0 && <Stats slot="hero" stats={page.stats} />}
  <article>

    {exp && (
      <>
        <dl class="facts">
          <div><dt>{t.from}</dt><dd>{exp.priceFrom != null ? `€${exp.priceFrom}` : t.priceOnRequest}</dd></div>
          <div><dt>{t.duration}</dt><dd>{exp.duration}</dd></div>
          <div><dt>{t.level}</dt><dd>{levelLabels[lang][exp.level]}</dd></div>
          {exp.groupSize && <div><dt>{t.groupSize}</dt><dd>{exp.groupSize}</dd></div>}
          <div><dt>{t.languages}</dt><dd>{exp.languages.join(', ')}</dd></div>
          {exp.meetingPoint && <div><dt>{t.meetingPoint}</dt><dd>{exp.meetingPoint}</dd></div>}
          {exp.season && <div><dt>{t.season}</dt><dd>{exp.season}</dd></div>}
        </dl>
      </>
    )}

    {showTrust && <TrustBar lang={lang} />}
    {cardsFirst && experiences.length > 0 && <ul class="cards">{experiences.map((e) => <Card entry={e} />)}</ul>}

    {area && (
      <dl class="facts">
        <div><dt>Region</dt><dd>{area.region}</dd></div>
        {area.routes && <div><dt>Routes</dt><dd>{area.routes}</dd></div>}
        {area.grades && <div><dt>Grades</dt><dd>{area.grades}</dd></div>}
        {area.style.length > 0 && <div><dt>Style</dt><dd>{area.style.join(', ')}</dd></div>}
        {area.approach && <div><dt>Approach</dt><dd>{area.approach}</dd></div>}
        {area.altitude && <div><dt>Altitude</dt><dd>{area.altitude}</dd></div>}
        {area.aspect && <div><dt>Aspect</dt><dd>{area.aspect}</dd></div>}
        {area.bestSeason && <div><dt>{t.season}</dt><dd>{area.bestSeason}</dd></div>}
        {area.access && <div><dt>{area.permit ? `⚠ ${t.permit}` : 'Access'}</dt><dd>{area.access}</dd></div>}
      </dl>
    )}

    <div class:list={['prose', { 'home-intro': isHome }]}><Content /></div>

    {exp && (exp.requirements.length > 0 || exp.includes.length > 0 || exp.bring.length > 0) && (
      <div class="lists">
        {exp.requirements.length > 0 && <section><h2>{t.requirements}</h2><ul>{exp.requirements.map((i) => <li>{i}</li>)}</ul></section>}
        {exp.includes.length > 0 && <section><h2>{t.included}</h2><ul>{exp.includes.map((i) => <li>{i}</li>)}</ul></section>}
        {exp.bring.length > 0 && <section><h2>{t.bring}</h2><ul>{exp.bring.map((i) => <li>{i}</li>)}</ul></section>}
      </div>
    )}
    {exp && <p><a class="btn" href={bookUrl} rel="noopener" target="_blank">{t.book}</a></p>}
    {linkedAreas.length > 0 && (<><h2>Where</h2><ul class="cards">{linkedAreas.map((e) => <Card entry={e} />)}</ul></>)}

    {area && area.links.length > 0 && (
      <><h2>Topos & references</h2><ul class="prose">{area.links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul></>
    )}
    {linkedExperiences.length > 0 && (<><h2>{t.climbHere}</h2><ul class="cards">{linkedExperiences.map((e) => <Card entry={e} />)}</ul></>)}

    {!cardsFirst && experiences.length > 0 && (
      <ul class:list={['cards', { 'cards--home': isHome }]} id="experiences">
        {isHome && contactPage && (
          <li class="promo">
            <Image src={promoPic.src} alt={promoPic.alt} widths={[640, 1024, 1400]} sizes="(max-width: 640px) 100vw, 50vw" />
            <div class="promo__text">
              <h3 class="display">{t.promoTitle}</h3>
              <p>{t.promoText}</p>
              <a class="btn btn--light" href={contactPage.data.path}>{t.ctaContact}</a>
            </div>
          </li>
        )}
        {experiences.map((e) => <Card entry={e} />)}
      </ul>
    )}
    {tenerife && <Tiles heading={tenerife.heading} items={tenerife.items} />}
    {whyUs && <Reasons heading={whyUs.heading} items={whyUs.items} link={whyUs.link} photo={photo('anaga-valley')} />}
    {areasHub && (
      <Banner photo={photo('teide-roques-sunset')} title={t.bannerTitle} text={t.bannerText} href={areasHub.data.path} label={t.bannerButton} />
    )}
    {areas.length > 0 && <ul class="cards">{areas.map((e) => <Card entry={e} />)}</ul>}
    {guides.length > 0 && <ul class="cards">{guides.map((e) => <Card entry={e} />)}</ul>}
    {planPages.length > 0 && <ul class="cards">{planPages.map((e) => <Card entry={e} />)}</ul>}

    {d.faq.length > 0 && (
      <section class="faq">
        <h2>{t.faq}</h2>
        {faqGroups.map(([group, items]) => (
          <>
            {group && <h3>{group}</h3>}
            {items.map((f) => (<details><summary><strong>{f.q}</strong></summary><p>{f.a}</p></details>))}
          </>
        ))}
      </section>
    )}

    {related.length > 0 && (<><h2>{t.related}</h2><ul class="cards">{related.map((e) => <Card entry={e} />)}</ul></>)}
  </article>
  {showCta && <Cta slot="after" lang={lang} bookUrl={bookUrl} />}
</Base>

<style>
  .lists { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0 40px; margin: 16px 0 32px; }
  .lists h2 { font-size: 18px; margin: 32px 0 12px; padding-bottom: 10px; border-bottom: 3px solid var(--ink); }
  .lists ul { margin: 0; padding-left: 1.2em; }
  .lists li { margin: 6px 0; }
  .lists li::marker { color: var(--accent); }
  .cards--home { grid-template-columns: repeat(4, 1fr); grid-auto-flow: dense; }
  .promo { position: relative; grid-column: span 2; display: flex; align-items: flex-end; min-height: 420px; color: #fff; background: var(--ink); isolation: isolate; overflow: hidden; }
  .promo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .promo::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(10 12 16 / 0.85), rgb(10 12 16 / 0.05) 65%); }
  .promo__text { padding: clamp(22px, 3vw, 36px); }
  .promo h3 { color: #fff; font-size: clamp(24px, 2.6vw, 34px); margin: 0 0 10px; }
  .promo p { margin: 0 0 20px; max-width: 40ch; }
  @media (max-width: 1100px) { .cards--home { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .cards--home { grid-template-columns: 1fr; } .promo { grid-column: auto; min-height: 360px; } }
  .home-intro :global(p:first-child) { font-size: clamp(20px, 2.2vw, 26px); line-height: 1.45; color: var(--ink); font-weight: 500; max-width: 36ch; }
</style>
